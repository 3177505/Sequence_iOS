[Unit]
Description=Sequence_site — Sequence_iOS Git update, build dist, HTTP server
Documentation=https://github.com/3177505/Sequence_iOS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=30
StartLimitBurst=12
StartLimitIntervalSec=600
TimeoutStartSec=0

WorkingDirectory=@@REPO_ROOT@@
ExecStart=@@REPO_ROOT@@/deploy/raspberry-pi/sequence-site.sh

Environment=SEQUENCE_SITE_DIR=@@SITE_DIR@@
Environment=SEQUENCE_REPO_URL=https://github.com/3177505/Sequence_iOS.git
Environment=SEQUENCE_BRANCH=main
Environment=SEQUENCE_HTTP_PORT=@@SEQUENCE_HTTP_PORT@@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sequence-site

User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@

[Install]
WantedBy=multi-user.target
